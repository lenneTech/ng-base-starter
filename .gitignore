# Dependencies and package-manager state
node_modules
.pnpm-store/
node-compile-cache/
*.log*

# Angular CLI cache (build + dev-server), never committed
.angular

# Build output. `pnpm run build` writes `.output` (browser/ + server/ + the
# server/index.mjs shim). `NG_OUTPUT_DIR` moves it: the check chain builds into
# `.output-check` (so it never overwrites the `.output` a local build left
# behind) and `lt dev test` into `.output-test`. The catch-all covers every other
# `.output-<x>` a manual run may spawn.
.output
.output-check
.output-test
.output-*
dist
/tmp
/out-tsc

# Local environment (`.env.example` is the committed template)
.env

# Tests
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
__screenshots__/

# lt dev runtime directory (logs, env bridge)
.lt-dev

# lt-memory: the agent-memory symlink into the private claude-memory repository
**/.claude/agent-memory

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# System files
.DS_Store
**/.DS_Store
Thumbs.db
