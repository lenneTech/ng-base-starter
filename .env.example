# Local defaults for `pnpm run dev` without `lt dev up` (copy to `.env`; `scripts/dev.mjs` loads it,
# variables already set in the shell win). Under `lt dev up` the CLI sets every value below for you
# (`https://<slug>.localhost` / `https://api.<slug>.localhost`).
#
# Every NG_* value is read by the SSR server AT REQUEST TIME (`ltAngularRequestHandler` in src/server.ts;
# the starter's own public values in src/server/starter-runtime-config.ts) and handed to the browser,
# never baked into the bundle. A deployed stage sets them on the container; the same image runs on
# every stage. The built server (`node .output/server/index.mjs`) does NOT read this file.

# Site URL. REQUIRED in production, with a dual role:
#  - canonical and sitemap URLs (robots.txt names `<site>/sitemap.xml`), and the host the SSR engine
#    accepts in addition to localhost (Angular answers 400 to any other Host header);
#  - the origin of the absolute auth redirect URLs in password-reset and e-mail-verification mails.
NG_PUBLIC_SITE_URL=http://localhost:3001

# Deployment stage label: `local`, `develop`, `test` or `production` (the stage names of nest-server and
# `lt deployment`). Anything but `production` makes the whole site noindex and enables the bug.lt reporter;
# shown under /app/admin/system. Unset means `production`.
NG_PUBLIC_APP_ENV=local
NODE_ENV=development

# Build identity, surfaced under /app/admin/system to detect a stale container. Normally injected by
# the Dockerfile (APP_VERSION_COMMIT build arg); `unknown` locally.
NG_PUBLIC_APP_COMMIT=unknown

# The API as the SSR server reaches it (and the dev proxy target in classic mode). NOT a
# `generate-types` setting: that command reads NG_API_URL from the SHELL environment (and
# `<repo-root>/.lt-dev/.env`), never from this file, and refuses to guess a port (DEV-2802).
NG_API_URL=http://localhost:3000
# The API as the browser reaches it.
NG_PUBLIC_API_URL=http://localhost:3000

# localStorage namespace prefix (prevents key collisions between projects on localhost).
# `lt dev up` overrides it with the project slug.
NG_PUBLIC_STORAGE_PREFIX=my-project-local

# Must match the backend's COOKIE_PREFIX when that is set (cookie `<prefix>.session_token`).
NG_PUBLIC_COOKIE_PREFIX=

# ---------------------------------------------------------------------------
# Local development API proxy (proxy.conf.mjs)
# ---------------------------------------------------------------------------
# `true` routes browser API calls through the dev server under `/api` (stripped before forwarding),
# so in classic mode (app :3001, API :3000) the session cookie is first-party and WebAuthn sees the
# app origin. `lt dev up` serves both on HTTPS subdomains with a shared cookie domain and always
# exports `false`; deployed stages call the API directly via NG_PUBLIC_API_URL.
NG_PUBLIC_API_PROXY=true

# Extra host names the SSR engine accepts (comma separated, `*.example.com` allowed). The host of
# NG_PUBLIC_SITE_URL and localhost are always accepted.
# NG_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Analytics (Plausible): off unless this names the analytics host, e.g. https://plausible.example.
# Without it there is no tracker, no request and no preconnect, never a fallback to plausible.io.
# Analytics never sees a token, e-mail address, record id or click id.
# ---------------------------------------------------------------------------
NG_PUBLIC_PLAUSIBLE_API_HOST=

# bug.lt reporter: on outside production (`NG_PUBLIC_APP_ENV`), off in production and without a stage label.
# `NG_PUBLIC_LT_BUG_ENABLED=true|false` overrides that per stage. Reports go to `POST /_bug-lt/report` on this
# server, which files them in Linear; the Linear values below stay on the server, never in the browser.
NG_PUBLIC_LT_BUG_ENABLED=
# Button and capture options (all optional): position `bottom-right` (default) | `bottom-left` | `top-right` |
# `top-left`; colour and text of the button; `false` to hide the button (open the dialog from your own code) or to
# skip the screenshot; `true` to open the dialog on an uncaught error.
# NG_PUBLIC_LT_BUG_POSITION=bottom-right
# NG_PUBLIC_LT_BUG_BUTTON_COLOR=
# NG_PUBLIC_LT_BUG_BUTTON_TEXT=
# NG_PUBLIC_LT_BUG_AUTO_SHOW=true
# NG_PUBLIC_LT_BUG_ENABLE_SCREENSHOT=true
# NG_PUBLIC_LT_BUG_AUTO_OPEN_ON_ERROR=false
NG_LINEAR_API_KEY=
NG_LINEAR_TEAM_NAME=
NG_LINEAR_PROJECT_NAME=

# ---------------------------------------------------------------------------
# Dev server and build (per command, normally not set here)
# ---------------------------------------------------------------------------
# PORT             — dev port, default 3001 (`lt dev` assigns its own). The built server defaults to 3000.
# HOST             — listen address (`pnpm run start:extern` sets 0.0.0.0).
# NG_OUTPUT_DIR    — build output dir, default `.output`. `pnpm run check` uses `.output-check`,
#                    `lt dev test` `.output-test`.
# E2E_BUILT_SERVER — `true` makes Playwright start the BUILT server (`node .output/server/index.mjs`)
#                    instead of the dev server. Requires a prior `pnpm run build`. Set by CI.
