/* Component and service specs next to their code (src/**), run by `ng test`. The tooling tests in tests/unit/ have tsconfig.tests.json. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "src/test-setup.ts"]
}
