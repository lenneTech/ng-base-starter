{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "endOfLine": "lf",
  "printWidth": 180,
  "semi": true,
  "singleQuote": true,
  // Angular style-guide file names (`login-page.html`, no `.component` suffix) are not
  // auto-detected as Angular templates (oxfmt only matches `*.component.html`), so they
  // would be formatted as plain HTML and mangle `@if`/`@for` blocks. Map them explicitly.
  // `src/index.html` is a plain document and stays HTML (the later entry wins).
  "associations": [
    { "files": ["src/**/*.html"], "language": "angular-html" },
    { "files": ["src/index.html"], "language": "html" },
  ],
  // src/api-client/ is formatted, not ignored: the generator runs oxfmt on it (openapi-ts.config.ts `postProcess`), and
  // oxfmt on a path it ignores exits 2, which failed every generate-types run (tests/unit/oxlint-generated-client.test.ts).
  "ignorePatterns": [".angular", ".output", ".output-*", "node_modules", "dist", "coverage", "playwright-report", "test-results", "pnpm-lock.yaml"],
}
